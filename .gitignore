# Gradle
.gradle/
build/
**/build/

# Local config (contiene path SDK locali — usa local.properties.template)
local.properties

# Android Studio / IntelliJ
*.iml
.idea/
*.iws
*.ipr
.DS_Store

# Native build artifacts
.externalNativeBuild/
.cxx/

# APK / AAB / mappings
*.apk
*.aab
*.ap_
output-metadata.json

# Android SDK platform-tools, downloaded locally — not part of the source
platform-tools/
platform-tools.zip

# Scan index copied out of a data root while debugging
/_index.json

# What a crashing JVM leaves in its working directory — a daemon started from
# shared/, a Gradle test worker in a module. They describe one machine at one
# moment and mean nothing to anyone else.
hs_err_pid*.log
replay_pid*.log
# The same kind of leftover: the heap dump a JVM run out of memory writes
# (java_pid*.hprof, often hundreds of MB), and the .kotlin/ directory the
# Kotlin Gradle plugin keeps beside a build for its session and error files.
*.hprof
.kotlin/

# The packaged daemon: a jlink runtime plus the jars, ~150 MB, rebuilt by
# package.sh whenever it is needed.
shared/dist/
