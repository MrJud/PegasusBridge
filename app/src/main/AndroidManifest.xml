<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".DataLayerApp"
        android:label="Pegasus Bridge"
        android:icon="@android:drawable/sym_def_app_icon">

        <!-- ── Router principale ─────────────────────────────────── -->
        <activity
            android:name=".DataLayerRouter"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">

            <!-- pegasus-data:// (nuovo scheme) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pegasus-data" />
            </intent-filter>

            <!-- rahasher:// (alias backward-compat — Phase 7 lo rimuove) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rahasher" />
            </intent-filter>

            <!-- pegasus-video:// (alias backward-compat — Phase 7 lo rimuove) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pegasus-video" />
            </intent-filter>
        </activity>

        <!-- ── Services ──────────────────────────────────────────── -->
        <service
            android:name="com.pegasus.bridge.media.MediaService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name="com.pegasus.bridge.hasher.HasherService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name="com.pegasus.bridge.ra.RaService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>
</manifest>
