{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "credentials",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "ra": {
      "type": "object",
      "properties": {
        "user":   { "type": "string" },
        "apiKey": { "type": "string" }
      }
    },
    "steamGridDb": {
      "type": "object",
      "properties": { "apiKey": { "type": "string" } }
    },
    "igdb": {
      "type": "object",
      "properties": {
        "clientId":      { "type": "string" },
        "clientSecret":  { "type": "string" },
        "cachedToken":   { "type": "string" },
        "cachedTokenExp":{ "type": "integer" }
      }
    },
    "steam":  { "type": "object" },
    "ign":    { "type": "object" },
    "rawg": {
      "type": "object",
      "properties": { "apiKey": { "type": ["string", "null"] } }
    },
    "updatedAt": { "type": "integer" }
  }
}
