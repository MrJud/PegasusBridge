@@ -1211,7 +1278,14 @@ static int rc_hash_wii_disc(md5_state_t* md5, const rc_hash_iterator_t* iterator
         cluster_count, cluster_count * CLUSTER_SIZE);
       for (ix = 0; ix < cluster_count; ix++) {
