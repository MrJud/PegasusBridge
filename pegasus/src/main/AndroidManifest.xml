<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Seeing an emulator that was not known when this APK was built.

      `config/emulators.json` exists so somebody can add an emulator without
      waiting for a new build, and without this that only half worked: from API
      30 a package the manifest does not name is invisible, so a freshly added
      entry could name an installed app and find nothing. Measured before this
      was added — an entry for `org.videolan.vlc`, installed and undeclared,
      produced no candidate at all.

      Refused once, on the reasoning that this app needs to know about twenty-odd
      emulators rather than about everything a person has installed. That was the
      right call while the list was fixed. It stopped being right the moment the
      list became the user's to extend: the alternative is telling somebody their
      emulator cannot be seen until the maintainer ships a new APK, which is the
      problem the file was built to remove.

      Sideloaded, not on Play, so Play's restricted-permission policy does not
      apply here. It grants no data access — only the ability to ask whether a
      named package exists, which is the whole of what discovery does with it.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
      Package visibility, API 30 and up.

      Without this, `getPackageInfo` throws NameNotFoundException for an
      emulator that is installed, and discovery reports an empty device with no
      error anywhere. QUERY_ALL_PACKAGES would also work and is refused on
      purpose: this app needs to know about twenty-odd emulators, not about
      everything a person has installed.

      Now a fallback rather than the mechanism: QUERY_ALL_PACKAGES above covers
      everything. Kept, and kept correct, so that removing that permission — for
      a Play release, say — leaves the built-in table working instead of blind.

      Kept in step with AndroidEmulators.PROBES by
      AndroidEmulatorsTest.`every probed package is declared in the manifest`,
      which reads the compiled table rather than the source text. That is not
      pedantry: the first version of this list was generated by a line-based
      grep, which silently skipped the one probe whose packages span two lines,
      and the test is what caught it.
    -->
    <queries>
        <package android:name="com.dsemu.drastic" />
        <package android:name="com.explusalpha.GbaEmu" />
        <package android:name="com.explusalpha.GbcEmu" />
        <package android:name="com.explusalpha.MdEmu" />
        <package android:name="com.explusalpha.NesEmu" />
        <package android:name="com.explusalpha.Snes9xPlus" />
        <package android:name="com.flycast.emulator" />
        <package android:name="com.github.eka2l1" />
        <package android:name="com.github.stenzek.duckstation" />
        <package android:name="com.pixelrespawn.linkboy" />
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.aarch64" />
        <package android:name="com.retroarch.ra32" />
        <package android:name="com.xiaoji.egggame" />
        <package android:name="io.github.lime3ds.android" />
        <package android:name="io.mgba" />
        <package android:name="io.recompiled.redream" />
        <package android:name="me.magnum.melonds" />
        <package android:name="org.citra.citra_emu" />
        <package android:name="org.citron.citron_emu" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.mupen64plusae.v3.fzurita" />
        <package android:name="org.mupen64plusae.v3.fzurita.pro" />
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="org.ppsspp.ppssppgold" />
        <package android:name="org.vita3k.emulator" />
        <package android:name="xyz.aethersx2.android" />
    </queries>

</manifest>
